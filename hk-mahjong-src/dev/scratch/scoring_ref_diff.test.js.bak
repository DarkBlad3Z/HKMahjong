#!/usr/bin/env node
/* HK Mahjong — tests/qa/scoring_ref_diff.test.js
 * QA: Reference scorer implementation, compared against real scorer on 20,000+ random winning hands.
 * 
 * This builds an INDEPENDENT reference scorer from the SPEC rules and performs differential testing,
 * comparing Fan totals computed by reference implementation vs. real implementation.
 */
'use strict';
const path = require('path');
const CORE = path.join(__dirname, '..', '..', 'src', 'core');

require(path.join(CORE, 'tiles.js'));
require(path.join(CORE, 'rng.js'));
require(path.join(CORE, 'hand.js'));
require(path.join(CORE, 'scoring.js'));

const HKMJ = globalThis.HKMJ;
const T = HKMJ.Tiles;
const H = HKMJ.Hand;
const S = HKMJ.Scoring;

const HAND_COUNT = 20000;

// ================================================================================================
// HAND GENERATOR
// ================================================================================================

function RandomHandGen(seed) {
  this.rng = new HKMJ.RNG(seed);
}

RandomHandGen.prototype.randomChow = function() {
  const suit = this.rng.int(3);
  const rank = this.rng.int(7);
  return [suit * 9 + rank, suit * 9 + rank + 1, suit * 9 + rank + 2];
};

RandomHandGen.prototype.randomPong = function() {
  const k = this.rng.int(34);
  return [k, k, k];
};

RandomHandGen.prototype.randomKong = function() {
  const k = this.rng.int(34);
  return [k, k, k, k];
};

RandomHandGen.prototype.generateHand = function() {
  // Bias: 30% single suit, 15% honour-heavy, 10% 1s/9s/honours
  const bias = this.rng.next();
  let singleSuit = -1;
  let honourBias = false;
  let terminalBias = false;
  
  if (bias < 0.30) {
    singleSuit = this.rng.int(3); // 0=man, 1=pin, 2=sou
  } else if (bias < 0.45) {
    honourBias = true;
  } else if (bias < 0.55) {
    terminalBias = true;
  }

  // Generate 4 sets
  const sets = [];
  let hasKong = false;
  
  for (let i = 0; i < 4; i++) {
    let set;
    const r = this.rng.next();
    
    if (r < 0.3) {
      // Chow
      let suit = singleSuit >= 0 ? singleSuit : this.rng.int(3);
      const rank = this.rng.int(7);
      set = [suit * 9 + rank, suit * 9 + rank + 1, suit * 9 + rank + 2];
    } else if (r < 0.6) {
      // Pong
      let k;
      if (honourBias) {
        k = 27 + this.rng.int(7); // honours
      } else if (terminalBias) {
        const suit = this.rng.int(3);
        const rank = this.rng.int(2) === 0 ? 0 : 8; // 1 or 9
        k = suit * 9 + rank;
      } else if (singleSuit >= 0) {
        k = singleSuit * 9 + this.rng.int(9);
      } else {
        k = this.rng.int(34);
      }
      set = [k, k, k];
    } else {
      // Kong
      let k;
      if (honourBias) {
        k = 27 + this.rng.int(7);
      } else if (terminalBias) {
        const suit = this.rng.int(3);
        const rank = this.rng.int(2) === 0 ? 0 : 8;
        k = suit * 9 + rank;
      } else if (singleSuit >= 0) {
        k = singleSuit * 9 + this.rng.int(9);
      } else {
        k = this.rng.int(34);
      }
      set = [k, k, k, k];
      hasKong = true;
    }
    sets.push(set);
  }

  // Generate pair
  let pair;
  if (honourBias) {
    pair = 27 + this.rng.int(7);
  } else if (terminalBias) {
    const suit = this.rng.int(3);
    const rank = this.rng.int(2) === 0 ? 0 : 8;
    pair = suit * 9 + rank;
  } else if (singleSuit >= 0) {
    pair = singleSuit * 9 + this.rng.int(9);
  } else {
    pair = this.rng.int(34);
  }

  // Check tile counts
  const allTiles = [];
  sets.forEach(s => allTiles.push(...s));
  allTiles.push(pair, pair);

  const counts = new Array(34).fill(0);
  for (const k of allTiles) {
    if (k < 34) counts[k]++;
  }
  
  for (let k = 0; k < 34; k++) {
    if (counts[k] > 4) return null;
  }

  // Declare melds (35% probability, but kongs are always declared)
  const melds = [];
  const declaredSetIndices = new Set();
  
  for (let i = 0; i < sets.length; i++) {
    const set = sets[i];
    const isKong = set.length === 4;
    
    if (isKong || this.rng.next() < 0.35) {
      const meldType = set.length === 3 && set[0] === set[1] ? 'pong' : 'chow';
      const meldKong = set.length === 4 ? 'kong' : meldType;
      
      // Kong is concealed with 40% probability
      const concealed = isKong && this.rng.next() < 0.40;
      
      melds.push({
        type: meldKong,
        tiles: set.slice(),
        concealed: concealed
      });
      declaredSetIndices.add(i);
    }
  }

  // Concealed tiles = non-meld sets + pair
  const concealedTiles = [];
  for (let i = 0; i < sets.length; i++) {
    if (!declaredSetIndices.has(i)) {
      concealedTiles.push(...sets[i]);
    }
  }
  concealedTiles.push(pair, pair);

  // Shuffle concealed tiles for win tile selection
  if (concealedTiles.length === 0) return null;

  // Win tile = random from concealed tiles
  const winTile = concealedTiles[this.rng.int(concealedTiles.length)];

  // Source
  const sources = ['self', 'discard'];
  const source = sources[this.rng.int(2)];

  // Kong replacement: only when source=self and hand has kongs (30% of those)
  let kongReplacement = 0;
  if (source === 'self' && hasKong && this.rng.next() < 0.3) {
    kongReplacement = this.rng.int(2) + 1; // 1 or 2
  }

  // Last tile (8%)
  const lastTile = this.rng.next() < 0.08;

  // Winds and flowers
  const seatWind = this.rng.int(4);
  const roundWind = this.rng.int(4);

  const flowerPool = [];
  for (let b = 34; b < 42; b++) flowerPool.push(b);
  this.rng.shuffle(flowerPool);
  const numFlowers = this.rng.int(5); // 0-4
  const flowers = flowerPool.slice(0, numFlowers);

  return {
    hand: concealedTiles,
    melds: melds,
    winTile: winTile,
    source: source,
    kongReplacement: kongReplacement,
    lastTile: lastTile,
    seatWind: seatWind,
    roundWind: roundWind,
    flowers: flowers,
    blessing: null,
    flowerWin: false,
    settings: {
      minFan: 0,
      optional: {
        kong: this.rng.next() < 0.5,
        sevenPairs: false,
        luxurySevenPairs: false,
        knitted: false,
        lesserHonours: false,
        greaterHonours: false
      }
    }
  };
};

// ================================================================================================
// REFERENCE SCORER IMPLEMENTATION
// ================================================================================================

/**
 * Compute reference score by trying all decompositions and placements.
 * Returns {raw, fan} for the best (highest fan, breaking ties by raw) interpretation.
 */
function refScore(ctx) {
  const { hand, melds, winTile, source, kongReplacement, lastTile, seatWind, roundWind, flowers, settings } = ctx;
  const opt = settings.optional;
  const LIMIT = 13;

  if (!hand || hand.length === 0) return { raw: 0, fan: 0 };

  const meldCount = melds ? melds.length : 0;
  const decomps = H.decompositions(hand, meldCount);
  
  if (decomps.length === 0) {
    return { raw: 0, fan: 0 };
  }

  let bestRaw = 0, bestFan = 0;

  // Try each decomposition
  for (const shape of decomps) {
    const { sets, pair } = shape;
    
    // Determine placements of win tile
    const placements = [];
    
    if (winTile !== null) {
      // Find which sets/pair contain the win tile kind
      for (let i = 0; i < sets.length; i++) {
        if (sets[i].tiles.includes(winTile)) {
          placements.push({ setIdx: i });
        }
      }
      if (pair === winTile) {
        placements.push({ pair: true });
      }
    } else {
      placements.push({});
    }

    // Try each placement
    for (const placement of placements) {
      // Compute score for this (decomposition, placement) combination
      let raw = 0;

      // Build tile arrays for analysis
      const allTiles = [];
      for (const s of sets) {
        allTiles.push(...s.tiles);
      }
      allTiles.push(pair, pair);
      for (const m of melds) {
        allTiles.push(...m.tiles);
      }

      // Determine concealed status
      const concealedHand = melds.every(m => m.type === 'kong' && m.concealed);

      // Check set types
      const allTrip = sets.every(s => {
        const k = s.tiles[0];
        return s.tiles.length === 3 && s.tiles[0] === s.tiles[1] && s.tiles[2] === s.tiles[0];
      });
      
      const allChow = sets.every(s => s.type === 'chow');
      const allKong = sets.every(s => s.type === 'kong');
      
      // Determine if all triplets are concealed
      const allConcealedTrips = allTrip && sets.every((s, i) => {
        if (s.type === 'kong') return s.concealed;
        // Non-meld sets are concealed unless win tile completes it via discard
        return !(placement.setIdx === i && (source === 'discard' || source === 'robKong'));
      });

      // Tile profile
      const suits = new Set();
      let hasHonour = false;
      let onlyTerminals = true;
      let hasTerminal = false;
      
      for (const k of allTiles) {
        if (k >= 27) {
          hasHonour = true;
          onlyTerminals = false;
        } else {
          const rank = k % 9;
          suits.add(Math.floor(k / 9));
          if (rank === 0 || rank === 8) {
            hasTerminal = true;
          } else {
            onlyTerminals = false;
          }
        }
      }
      
      const onlyHonours = suits.size === 0;
      const termOrHon = !hasTerminal || allTiles.every(k => T.isTerminal(k) || T.isHonour(k));

      // ===== SET TYPE SCORE =====
      let setTypeScore = 0;
      if (allChow) {
        setTypeScore = 1; // All Sequences
      } else if (!allTrip) {
        // Mixed set types - no set type score
        setTypeScore = 0;
      } else {
        // All triplets
        if (allKong) {
          setTypeScore = 13; // All Quadruplets
        } else if (allConcealedTrips) {
          setTypeScore = 8; // All Concealed Triplets
        } else {
          setTypeScore = 3; // All Triplets
        }
      }

      // ===== TILE TYPE SCORE (depends on set type) =====
      let tileTypeScore = 0;
      if (onlyHonours) {
        if (setTypeScore === 3) tileTypeScore = 10; // All Honours
        else if (setTypeScore === 8) tileTypeScore = 8 + 7;
        else if (setTypeScore === 13) tileTypeScore = 13 + 7;
      } else if (onlyTerminals) {
        tileTypeScore = 13; // All Terminals
      } else if (termOrHon && hasTerminal) {
        // Mixed Terminals
        if (setTypeScore === 3) tileTypeScore = 4;
        else if (setTypeScore === 8) tileTypeScore = 8 + 1;
        else if (setTypeScore === 13) tileTypeScore = 13 + 1;
      } else {
        // No special tile type, use set type
        tileTypeScore = setTypeScore;
      }

      raw += tileTypeScore;

      // ===== FLUSH =====
      if (!onlyHonours && suits.size === 1) {
        if (hasHonour) {
          raw += 3; // Mixed Flush
        } else {
          raw += 7; // Full Flush
        }
      }

      // ===== DRAGONS =====
      const dragonTrips = sets.filter(s => T.isDragon(s.tiles[0]) && s.type !== 'chow').length;
      
      if (dragonTrips === 3) {
        raw += 8; // Big Three Dragons
      } else if (dragonTrips === 2 && T.isDragon(pair)) {
        raw += 5; // Small Three Dragons
      } else {
        raw += dragonTrips; // 1 per dragon triplet
      }

      // ===== WINDS =====
      const windTrips = sets.filter(s => T.isWind(s.tiles[0]) && s.type !== 'chow').length;
      const roundWindKind = T.windKind(roundWind);
      const seatWindKind = T.windKind(seatWind);
      const hasRoundWind = sets.some(s => s.type !== 'chow' && s.tiles[0] === roundWindKind);
      const hasSeatWind = sets.some(s => s.type !== 'chow' && s.tiles[0] === seatWindKind);
      
      if (windTrips === 4) {
        raw += 13; // Big Four Winds
      } else if (windTrips === 3 && T.isWind(pair)) {
        raw += 6; // Small Four Winds
      } else {
        if (hasRoundWind) raw += 1;
        if (hasSeatWind) raw += 1;
      }

      // ===== KONG BONUS =====
      if (opt.kong && !allKong) {
        for (const s of sets) {
          if (s.type === 'kong') {
            raw += s.concealed ? 2 : 1;
          }
        }
      }

      // ===== WIN ACTIONS =====
      if (source === 'self') {
        if (kongReplacement >= 2) {
          raw += 9;
        } else if (kongReplacement === 1) {
          raw += 2;
        } else {
          raw += 1;
        }
      }
      
      if (lastTile) {
        raw += 1;
      }
      
      if (concealedHand && !allConcealedTrips) {
        raw += 1;
      }

      // ===== BONUS TILES =====
      if (flowers.length === 0) {
        raw += 1;
      } else {
        const seatFlowerNum = seatWind + 1;
        for (const f of flowers) {
          if (T.bonusNumber(f) === seatFlowerNum) {
            raw += 1;
          }
        }
        const hasAllFlowers = flowers.includes(34) && flowers.includes(35) && flowers.includes(36) && flowers.includes(37);
        const hasAllSeasons = flowers.includes(38) && flowers.includes(39) && flowers.includes(40) && flowers.includes(41);
        if (hasAllFlowers) raw += 2;
        if (hasAllSeasons) raw += 2;
      }

      const fan = Math.min(LIMIT, raw);
      
      // Keep best
      if (fan > bestFan || (fan === bestFan && raw > bestRaw)) {
        bestFan = fan;
        bestRaw = raw;
      }
    }
  }

  return { raw: bestRaw, fan: bestFan };
}

// ================================================================================================
// TEST RUNNER
// ================================================================================================

const gen = new RandomHandGen(42);
const mismatches = [];
const timings = [];
let handsGenerated = 0;
let handsEvaluated = 0;
let mismatchByGroup = {};

console.log('Generating and testing ' + HAND_COUNT + ' random winning hands...\n');

for (let i = 0; i < HAND_COUNT; i++) {
  let ctx = null;
  let attempts = 0;
  
  while (!ctx && attempts < 10) {
    ctx = gen.generateHand();
    attempts++;
  }
  
  if (!ctx) continue;
  
  handsGenerated++;

  // Score with real scorer
  const t0 = Date.now();
  const realResult = S.evaluate(ctx);
  timings.push(Date.now() - t0);

  // Only test hands that real scorer says are winning standard hands
  if (!realResult.winning || realResult.pattern !== 'standard') {
    continue;
  }

  handsEvaluated++;

  // Compute reference score
  const refResult = refScore(ctx);

  // Compare
  if (refResult.fan !== realResult.fan) {
    const itemsKey = realResult.items.map(it => it.id).sort().join(',');
    if (!mismatchByGroup[itemsKey]) {
      mismatchByGroup[itemsKey] = 0;
    }
    mismatchByGroup[itemsKey]++;
    
    if (mismatches.length < 100) { // Keep first 100 for detailed reporting
      mismatches.push({
        idx: i,
        hand: T.format(ctx.hand),
        melds: (ctx.melds || []).map(m => ({
          type: m.type,
          tiles: T.format(m.tiles),
          concealed: m.concealed
        })),
        winTile: T.code(ctx.winTile),
        source: ctx.source,
        kongReplacement: ctx.kongReplacement,
        lastTile: ctx.lastTile,
        seatWind: ctx.seatWind,
        roundWind: ctx.roundWind,
        flowers: ctx.flowers.map(f => T.code(f)),
        optKong: ctx.settings.optional.kong,
        refFan: refResult.fan,
        realFan: realResult.fan,
        refRaw: refResult.raw,
        realRaw: realResult.rawFan,
        realItems: realResult.items.map(it => it.id)
      });
    }
  }
}

// Compute timing stats
let avgTime = 0, maxTime = 0, minTime = 9999;
for (const t of timings) {
  avgTime += t;
  maxTime = Math.max(maxTime, t);
  minTime = Math.min(minTime, t);
}
avgTime = timings.length > 0 ? avgTime / timings.length : 0;
minTime = timings.length > 0 ? minTime : 0;

// Report
console.log('=== HK MAHJONG REFERENCE SCORER DIFFERENTIAL TEST ===\n');
console.log('Hands generated:     ' + handsGenerated);
console.log('Hands evaluated:     ' + handsEvaluated);
console.log('Standard winners:    ' + timings.length);
console.log('Mismatches found:    ' + Object.values(mismatchByGroup).reduce((a,b) => a+b, 0));

if (mismatches.length > 0) {
  console.log('\n--- FIRST EXAMPLE FROM EACH MISMATCH GROUP ---');
  for (let i = 0; i < Math.min(10, mismatches.length); i++) {
    const m = mismatches[i];
    const itemsKey = m.realItems.sort().join(',');
    console.log('\nMismatch ' + (i+1) + ' (item set: ' + itemsKey + '):');
    console.log('  Hand:          ' + m.hand);
    console.log('  Melds:         ' + JSON.stringify(m.melds));
    console.log('  Win tile:      ' + m.winTile);
    console.log('  Source:        ' + m.source);
    console.log('  Ref fan:       ' + m.refFan + ' (raw: ' + m.refRaw + ')');
    console.log('  Real fan:      ' + m.realFan + ' (raw: ' + m.realRaw + ')');
  }
}

console.log('\n--- TIMING (from ' + timings.length + ' hands) ---');
console.log('Mean:   ' + avgTime.toFixed(4) + ' ms');
console.log('Max:    ' + maxTime + ' ms');
console.log('Min:    ' + minTime + ' ms');

console.log('\n');
process.exit(Object.values(mismatchByGroup).reduce((a,b) => a+b, 0) > 0 ? 1 : 0);
